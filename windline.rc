// Windline's Windows resources.
//
// This file exists only to be compiled into windline_amd64.syso by rsrc, which
// the Go linker then embeds in the executable. It holds the application icon and
// a version block, so the .exe shows a proper name and icon in Explorer, the
// taskbar and the notification area instead of a generic blank document.
//
// The icon it points at is generated by `windline --mkicon`, which draws it with
// the same code the running app uses for its tray icon. Nothing here is
// hand-drawn binary art.
//
// Build (build.ps1 does this automatically):
//   go run . --mkicon --out=assets/windline.ico
//   rsrc -ico assets/windline.ico -manifest windline.manifest -o windline_amd64.syso

1 ICON "assets/windline.ico"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Windline"
            VALUE "FileDescription",  "Windline - photos on a clothesline above your screen"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "windline"
            VALUE "LegalCopyright",   "MIT licensed. A Windows port of Tendedero by Alejandro Bujan."
            VALUE "OriginalFilename", "windline.exe"
            VALUE "ProductName",      "Windline"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END